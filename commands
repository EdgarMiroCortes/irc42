CONNECT:
	SERVER:
		./ircserv 4444 123 (iniciar servidor)
	CLIENT:
		nc -C 127.0.0.1 4444 (conectar cliente)
		PASS 123
		NICK user 1
		USER u1 0 * :usuario1

MESSAGES:
	TO A USER:
		PRIVMSG user2 : Mensaje privado!
	TO A CHANNEL:
		PRIVMSG #test : Mensaje por canal!

PERMISSIONS:
	MODE #test +o user1 (GIVE operator permissions to user1 in chanel #test)
	MODE #test -o user1 (REMOVE operator permissions to user1 in chanel #test)

INVITE ONLY:
	INVITE user #test (invite a user) -> to enter only JOIN normally
	MODE #test +i (GIVE to a channel to invite only)
	MODE #test -i (REMOVE invite only from a channel)

CHANNEL PASSWORDS:
	JOIN #test pass
	MODE #test +k pass (ADD password "pass" to a channel)
	MODE #test -k pass (REMOVE password from a channel)

TOPIC:
	TOPIC #test (display topic)
	TOPIC #test tirapollo (set topic)
	MODE #test +t (RESTRICT change channel topic to only operators)
	MODE #test -t (QUIT RESCTRICTION and all can change topic)

WHOIS user1 (solo funciona con nickname)

IRSSI:
/connect 127.0.0.1 4444 123
 /PRIVMSG user1 hola!
 /JOIN #test pass
 /PRIVMSG #test hola